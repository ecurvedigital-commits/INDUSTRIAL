{
  "name": "@raj/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "build": "pnpm --filter @raj/shared build && pnpm db:generate && nest build",
    "lint": "eslint src",
    "typecheck": "pnpm --filter @raj/shared build && pnpm db:generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @raj/shared build && pnpm db:generate && tsc -p tsconfig.test.json && node --test dist-test/test/*.spec.js",
    "db:generate": "prisma generate --schema prisma/schema/schema.prisma",
    "db:validate": "prisma validate --schema prisma/schema/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema prisma/schema/schema.prisma",
    "db:migrate:deploy": "prisma migrate deploy --schema prisma/schema/schema.prisma",
    "clean": "node -e \"for (const path of ['dist', 'dist-test']) require('node:fs').rmSync(path, { recursive: true, force: true })\""
  },
  "dependencies": {
    "@raj/shared": "workspace:*",
    "@prisma/client": "6.19.3",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "18.0.9",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.8",
    "@types/node": "24.10.1"
    ,"@types/supertest": "7.2.1",
    "prisma": "6.19.3",
    "supertest": "7.3.1",
    "tsx": "4.23.15"
  }
}